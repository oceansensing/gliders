---
/**
 * Every deployment on the DAC: a map, and a table you can search.
 *
 * The markup here is the shell. Rows and markers are built at runtime from
 * the live catalog, which is why the styles for them are in `global.css` and
 * in a `is:global` block below rather than in scoped rules — Astro stamps
 * its scoping attribute on the markup it compiles, not on nodes a script
 * appends later, so a scoped rule for `.row` would match nothing.
 */
---

<section class="controls" data-browser>
  <div class="row">
    <label class="grow">
      <span class="eyebrow">Search</span>
      <input
        class="field"
        type="search"
        data-search
        placeholder="glider, institution, or dataset id"
        autocomplete="off"
      />
    </label>
    <label>
      <span class="eyebrow">Year</span>
      <select class="field" data-year>
        <option value="">any</option>
      </select>
    </label>
    <button class="btn" type="button" data-active aria-pressed="true">Active only</button>
  </div>
  <p class="status eyebrow" data-status>Loading the catalog…</p>
</section>

<figure class="map-figure">
  <div class="map" data-map role="application" aria-label="Map of glider deployments"></div>
</figure>

<div class="table-wrap">
  <table data-table>
    <thead>
      <tr>
        <th scope="col"><button type="button" data-sort="title">Deployment</button></th>
        <th scope="col"><button type="button" data-sort="institution">Institution</button></th>
        <th scope="col"><button type="button" data-sort="start">Start</button></th>
        <th scope="col"><button type="button" data-sort="end">Last report</button></th>
        <th scope="col" class="num"><button type="button" data-sort="days">Days</button></th>
      </tr>
    </thead>
    <tbody data-rows></tbody>
  </table>
  <p class="more eyebrow" data-more hidden></p>
</div>

<style>
  .controls {
    margin-block: var(--space-lg) var(--space-md);
  }

  .controls .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: flex-end;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .grow {
    flex: 1 1 18rem;
  }

  .grow input {
    width: 100%;
  }

  .status {
    margin-block-start: var(--space-sm);
    text-transform: none;
    letter-spacing: 0;
  }

  .map-figure {
    margin: 0;
  }

  .map {
    height: clamp(20rem, 52vh, 34rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  .table-wrap {
    margin-block-start: var(--space-lg);
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  th {
    text-align: start;
    border-bottom: 1px solid var(--border);
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
  }

  th button {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  th button:hover {
    color: var(--text);
  }

  .more {
    margin-block-start: var(--space-sm);
    text-transform: none;
    letter-spacing: 0;
  }

  .num {
    text-align: end;
  }
</style>

<style is:global>
  /* Rows are built by the script, so these cannot be scoped rules. */
  [data-rows] tr {
    border-bottom: 1px solid var(--border);
  }

  [data-rows] td {
    padding: var(--space-xs) var(--space-sm) var(--space-xs) 0;
    vertical-align: baseline;
  }

  [data-rows] td.num,
  [data-rows] td.when {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    white-space: nowrap;
  }

  [data-rows] td.num {
    text-align: end;
  }

  [data-rows] .id {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.92em;
    color: var(--text-muted);
  }

  [data-rows] .live {
    display: inline-block;
    margin-inline-start: var(--space-xs);
    padding: 0 0.4em;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-size: 0.75em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 0.1em;
  }

  /**
   * A deployment still reporting, and one that has finished.
   *
   * **Opaque, and ringed.** Both used to be translucent accent — 0.55 and
   * 0.25 — which blends the dot toward whatever it is standing on, and what
   * it is standing on is water the same colour. Measured against the tiles
   * the map actually draws, the live dot came out at 1.09:1 in light mode
   * and **1.04:1 in dark**, and the archived one at 1.05:1. A ratio of 1.0
   * is the background.
   *
   * So the fill is solid and the colours are `--map-*`, which are fixed to
   * the basemap rather than to the theme, for the reason set out where they
   * are defined. The white ring is not decoration: nothing dark can be seen
   * against the near-black end of a track's colormap, and nothing light can
   * be seen against the pale shelf water, so the marker carries one of each
   * and is never worse than 3.4:1 on anything the map can put behind it.
   *
   * Classes rather than Leaflet's `color`/`fillColor` options, so the rule
   * lives with the palette — the one the plots keep too.
   */
  .marker-live {
    stroke: var(--map-ring);
    fill: var(--map-here);
    fill-opacity: 1;
  }

  .marker-past {
    stroke: var(--map-ring);
    fill: var(--map-past);
    fill-opacity: 1;
  }

  /* Hover cannot say it with opacity any more — the dot is already solid —
     so it says it by thickening the ring, which reads at this size and
     needs no second colour. */
  .marker-live:hover,
  .marker-past:hover {
    stroke-width: 4;
  }

  /**
   * **An invisible line still has to be clickable, and by default it is
   * not.**
   *
   * SVG's default `pointer-events: visiblePainted` means an element is a
   * target only where it is *painted* — and `stroke-opacity: 0` paints
   * nothing, so the fat transparent line laid over each track swallowed
   * exactly zero clicks. It looked like a hit-testing problem with thin
   * strokes and was a paint rule.
   *
   * `stroke` is the value that means "the stroke area, whatever the paint",
   * which is precisely what a hit target is.
   */
  /* `path.track-hit`, not `.track-hit`: Leaflet's own stylesheet carries
     `.leaflet-interactive { pointer-events: auto }` at the same specificity
     and is imported after this, so the bare class lost the cascade and the
     line went back to being unhittable — the same bug twice, once in SVG's
     paint rule and once in CSS ordering. The element selector settles it. */
  path.track-hit {
    pointer-events: stroke;
    cursor: pointer;
  }

  /* Leaflet's own chrome, themed. */
  .leaflet-container {
    background: var(--bg-subtle);
    font-family: var(--font-sans);
  }

  .leaflet-popup-content-wrapper,
  .leaflet-popup-tip {
    background: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    box-shadow: none;
    border-radius: var(--radius);
  }

  .leaflet-popup-content {
    margin: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
  }

  .leaflet-popup-content .id {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.9em;
  }

  .leaflet-bar a,
  .leaflet-control-attribution {
    background: var(--bg);
    color: var(--text-muted);
    border-color: var(--border);
  }

  .leaflet-bar a {
    color: var(--text);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import {
    DEFAULT_BASE, listDatasets, parseJsonlCsvStream, request, tabledapUrl,
    type DeploymentSummary,
  } from '@c4po/erddap';
  import { sample } from '@c4po/plot';
  import { withBase } from '../lib/url';
  import {
    INDEX_PATH, cleanTrack, decodeTrack, mainRuns, shardPath, trackYear,
    type TrackIndex, type TrackShard,
  } from '../lib/tracks';

  const root = document.querySelector<HTMLElement>('[data-browser]')!;
  const search = root.querySelector<HTMLInputElement>('[data-search]')!;
  const yearSel = root.querySelector<HTMLSelectElement>('[data-year]')!;
  const activeBtn = root.querySelector<HTMLButtonElement>('[data-active]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const tbody = document.querySelector<HTMLElement>('[data-rows]')!;
  const more = document.querySelector<HTMLElement>('[data-more]')!;
  const mapEl = document.querySelector<HTMLElement>('[data-map]')!;

  /** A deployment counts as active when it reported within this many days.
      Seven rather than one: a glider surfaces on its own schedule and a
      shorter window blinks deployments in and out of the default view. */
  const ACTIVE_DAYS = 7;
  /** Rows rendered at once. The table is 2,500 rows and nobody scrolls that
      far; the count of what is not shown is printed rather than hidden. */
  const PAGE = 300;

  let all: DeploymentSummary[] = [];
  /** The catalog by id. A baked track carries the last report it was baked
      at, and only the catalog knows the current one, so the shard reader
      needs to look each mission up. */
  const byId = new Map<string, DeploymentSummary>();
  function setCatalog(list: DeploymentSummary[]): void {
    all = list;
    byId.clear();
    for (const d of list) byId.set(d.id, d);
  }
  let shown: DeploymentSummary[] = [];
  let sortKey: 'title' | 'institution' | 'start' | 'end' | 'days' = 'end';
  let sortDir = -1;
  let limit = PAGE;

  // `fadeAnimation: false` — see the note in `lib/track.ts`: the fade is
  // driven by requestAnimationFrame, which a background tab never runs, so
  // downloaded tiles stay invisible until the tab is focused.
  const map = L.map(mapEl, { worldCopyJump: true, fadeAnimation: false })
    .setView([30, -60], 2);
  L.tileLayer(
    'https://server.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}',
    {
      maxZoom: 13,
      attribution: 'Esri — GEBCO, NOAA, National Geographic',
    },
  ).addTo(map);
  const markers = L.layerGroup().addTo(map);
  const trackLayer = L.layerGroup().addTo(map);

  const now = () => Date.now() / 1000;
  const isActive = (d: DeploymentSummary) => now() - d.end < ACTIVE_DAYS * 86400;
  const days = (d: DeploymentSummary) => Math.max(0, (d.end - d.start) / 86400);
  const date = (t: number) =>
    Number.isFinite(t) ? new Date(t * 1000).toISOString().slice(0, 10) : '—';

  /** The deployment page, for one dataset. */
  const link = (id: string) => `${withBase('/deployment/')}?dataset=${encodeURIComponent(id)}`;

  function filtered(): DeploymentSummary[] {
    const q = search.value.trim().toLowerCase();
    const year = yearSel.value;
    const activeOnly = activeBtn.getAttribute('aria-pressed') === 'true';
    const terms = q ? q.split(/\s+/) : [];

    return all.filter((d) => {
      if (activeOnly && !isActive(d)) return false;
      if (year) {
        const y = new Date(d.start * 1000).getUTCFullYear();
        const y2 = new Date(d.end * 1000).getUTCFullYear();
        if (String(y) !== year && String(y2) !== year) return false;
      }
      if (!terms.length) return true;
      // Every term has to match somewhere, so two words narrow rather than
      // widen — "rutgers 2019" is one question, not two.
      const hay = `${d.id} ${d.title} ${d.institution}`.toLowerCase();
      return terms.every((t) => hay.includes(t));
    });
  }

  function sorted(rows: DeploymentSummary[]): DeploymentSummary[] {
    const key = sortKey;
    return [...rows].sort((a, b) => {
      let d = 0;
      if (key === 'title') d = a.title.localeCompare(b.title);
      else if (key === 'institution') d = a.institution.localeCompare(b.institution);
      else if (key === 'days') d = days(a) - days(b);
      else d = a[key] - b[key];
      return d * sortDir;
    });
  }

  function render(): void {
    shown = sorted(filtered());

    tbody.replaceChildren();
    const frag = document.createDocumentFragment();
    for (const d of shown.slice(0, limit)) {
      const tr = document.createElement('tr');

      const name = document.createElement('td');
      const a = document.createElement('a');
      a.href = link(d.id);
      // The DAC's title is very often just the dataset id. Printing both
      // then says the same thing twice, so the id line is dropped when it
      // adds nothing.
      a.textContent = d.title || d.id;
      name.append(a);
      if (isActive(d)) {
        const badge = document.createElement('span');
        badge.className = 'live';
        badge.textContent = 'active';
        name.append(badge);
      }
      if (d.title && d.title !== d.id) {
        const id = document.createElement('span');
        id.className = 'id';
        id.textContent = d.id;
        name.append(id);
      }
      tr.append(name);

      const inst = document.createElement('td');
      inst.textContent = d.institution;
      tr.append(inst);

      for (const t of [d.start, d.end]) {
        const cell = document.createElement('td');
        cell.className = 'when';
        cell.textContent = date(t);
        tr.append(cell);
      }

      const dur = document.createElement('td');
      dur.className = 'num';
      dur.textContent = days(d) >= 1 ? days(d).toFixed(0) : '<1';
      tr.append(dur);

      frag.append(tr);
    }
    tbody.append(frag);

    const hiddenCount = shown.length - Math.min(limit, shown.length);
    more.hidden = hiddenCount <= 0;
    more.textContent = hiddenCount > 0
      ? `${hiddenCount.toLocaleString()} more match — narrow the search, or `
      : '';
    if (hiddenCount > 0) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn';
      btn.textContent = 'show all';
      btn.addEventListener('click', () => { limit = Infinity; render(); });
      more.append(btn);
    }

    drawMarkers();
    drawTracks();
    say();
    void loadTracks(shown);
  }

  /**
   * Each mission's actual path, coloured by its own time.
   *
   * A dot at the centre of a bounding box says a glider was somewhere in the
   * Mid-Atlantic; the path says it ran the shelf break for eleven days and
   * which way it went. It costs little: a whole mission at one fix per six
   * hours is a few dozen points — 3 KB and about a fifth of a second — so
   * the expensive part is the *number* of requests, not any one of them.
   *
   * **Capped, and the cap is said out loud.** The archive is 2,534
   * deployments and nobody wants 2,534 requests; the tracks are drawn for
   * what is on screen, up to `TRACK_CAP`, and the status line reports when
   * that bit.
   *
   * **The colour runs over one absolute clock shared by every track on
   * screen**, not over each mission's own span. That is what makes the map
   * answer "when": two gliders out the same season come back the same
   * colour, and a 2019 deployment is visibly a different colour from a 2026
   * one. Normalising per mission would have made every track run the same
   * gradient and told the reader nothing except which way each one went.
   *
   * It reads well at both scales without a switch. Filtered to the active
   * deployments the span is a few weeks, so the colour separates missions
   * within a season; across the whole archive the span is decades and each
   * mission arrives as essentially one colour, which is the point.
   */
  /**
   * **How many tracks are drawn, and why it is no longer sixty.**
   *
   * It was sixty because every one of them was a request to the DAC, and the
   * archive is 2,534 deployments. That made the cap bite in the one place it
   * was least wanted: the default sort is most-recent-first, so turning
   * "Active only" off drew the sixty *newest* tracks, which are the ones
   * already on screen — the archive had dots and nothing else, whatever the
   * reader filtered to.
   *
   * With the archive baked into this site the data is no longer the limit,
   * and what is left is drawing. The cap is above the size of the catalog so
   * it does not bite at all today; `SEGMENT_BUDGET` is what actually bounds
   * the work, and it bounds it by the total rather than per track.
   */
  const TRACK_CAP = 3000;
  const TRACK_EVERY = '6hours';
  const TRACK_COLORMAP = 'cmo.thermal';
  /**
   * Each mission's path, already split into the runs it could have swum.
   *
   * Cleaned once, where it arrives, rather than on every redraw: the rule is
   * a great-circle distance per step, and half a million of those on every
   * sort of the table would cost more than drawing does. See `cleanTrack` in
   * `lib/tracks.ts` for what it removes and why.
   */
  const tracks = new Map<string, Array<Array<[number, number]>>>();
  let trackRun = 0;

  /**
   * Archived tracks, kept between visits.
   *
   * **Only the archived ones.** A deployment that is still reporting grows
   * every few hours, so caching its path would show a reader a glider that
   * had stopped moving — the one thing a live map must not do. A finished
   * mission's path is final and there is no reason to fetch it twice.
   *
   * Stored at four decimal places, which is about eleven metres — far finer
   * than a six-hour fix and a third of the bytes of full precision. The
   * budget is a count rather than a size so eviction is predictable, and
   * every access is wrapped: `localStorage` *throws* where a browser is set
   * to block site data, and a map that fails to draw because a cache could
   * not be read would be a poor trade for the saving.
   */
  const CACHE_KEY = 'gliders.tracks.v1';
  const CACHE_MAX = 400;
  type Cached = Record<string, { end: number; path: number[] }>;

  function readCache(): Cached {
    try {
      return JSON.parse(localStorage.getItem(CACHE_KEY) ?? '{}') as Cached;
    } catch {
      return {};
    }
  }

  let cache: Cached = readCache();
  let cacheDirty = false;

  function cacheGet(d: DeploymentSummary): Array<[number, number]> | null {
    const hit = cache[d.id];
    /* Keyed on the last report as well as the id: a mission that was
       archived when it was cached but has since reported again is a
       different path, and the stale one would be wrong rather than merely
       old. */
    if (!hit || hit.end !== Math.round(d.end)) return null;
    const path: Array<[number, number]> = [];
    for (let i = 0; i + 1 < hit.path.length; i += 2) path.push([hit.path[i], hit.path[i + 1]]);
    return path;
  }

  function cachePut(d: DeploymentSummary, path: Array<[number, number]>): void {
    if (isActive(d) || path.length < 2) return;
    const flat: number[] = [];
    for (const [lat, lon] of path) {
      flat.push(Math.round(lat * 1e4) / 1e4, Math.round(lon * 1e4) / 1e4);
    }
    cache[d.id] = { end: Math.round(d.end), path: flat };
    cacheDirty = true;
  }

  /** Written once the fetching settles rather than per track: a hundred
      serialisations of a growing object is the expensive way to save. */
  function flushCache(): void {
    if (!cacheDirty) return;
    cacheDirty = false;
    try {
      const ids = Object.keys(cache);
      if (ids.length > CACHE_MAX) {
        /* Oldest last-report first: the missions a reader is least likely to
           come back to. */
        const keep = ids
          .sort((a, b) => (cache[b].end ?? 0) - (cache[a].end ?? 0))
          .slice(0, CACHE_MAX);
        const next: Cached = {};
        for (const id of keep) next[id] = cache[id];
        cache = next;
      }
      localStorage.setItem(CACHE_KEY, JSON.stringify(cache));
    } catch {
      /* Full, or blocked. The map is already drawn; the next visit simply
         fetches again. */
    }
  }

  /**
   * The archive, read from this site rather than from the DAC.
   *
   * A finished mission's path never changes, so it is baked at build time
   * into one file per start year — see `lib/tracks.ts` and
   * `scripts/fetch-tracks.mjs`. The whole archive is 2,481 missions and about
   * 1.4 MB compressed, split so that looking at one year costs one shard.
   *
   * **What this replaces**: 2,481 requests to somebody else's server, per
   * reader, per visit, to draw a background map. What it does not replace is
   * a mission still reporting — that one is fetched live, every time, because
   * a baked path would show a glider that had stopped moving.
   *
   * Missing shards are not an error. A build with no baked data, a year that
   * has not been baked yet, a mission that finished since the last bake —
   * each simply falls through to the DAC, which is where the data was coming
   * from before any of this existed.
   */
  const shards = new Map<number, Promise<void>>();
  let shardIndex: Promise<TrackIndex | null> | null = null;

  function trackArchive(): Promise<TrackIndex | null> {
    shardIndex ??= fetch(withBase(`/${INDEX_PATH}`))
      .then((r) => (r.ok ? r.json() as Promise<TrackIndex> : null))
      .catch(() => null);
    return shardIndex;
  }

  /** Pull in whatever shards the visible archived missions fall into, and
      resolve once they are all in — so the DAC pass below asks only for what
      is genuinely not baked. */
  async function loadShards(list: DeploymentSummary[]): Promise<void> {
    /* Asked for before the index is, so the default view — active only —
       fetches nothing at all from here. */
    const years = new Set<number>();
    for (const d of list) {
      if (isActive(d) || tracks.has(d.id)) continue;
      years.add(trackYear(d.start));
    }
    if (!years.size) return;

    const index = await trackArchive();
    if (!index) return;
    const have = new Set(index.years.map((y) => y.year));
    const want = new Set([...years].filter((y) => have.has(y)));

    for (const year of want) {
      if (shards.has(year)) continue;
      shards.set(year, fetch(withBase(`/${shardPath(year)}`))
        .then((r) => (r.ok ? r.json() as Promise<TrackShard> : null))
        .then((shard) => {
          if (!shard) return;
          for (const [id, baked] of Object.entries(shard.tracks)) {
            /* Keyed on the last report, exactly as the `localStorage` cache
               is: a deployment that was archived when it was baked and has
               reported again since is a different path, and the baked one
               would be wrong rather than merely old. `byId` is the catalog,
               which is the only thing that knows the current one. */
            const d = byId.get(id);
            if (!d || baked.end !== Math.round(d.end)) continue;
            if (!tracks.has(id)) {
              tracks.set(id, cleanTrack(decodeTrack(baked.p, shard.precision)));
            }
          }
        })
        .catch(() => { /* falls through to the DAC, which is the old path */ }));
    }

    await Promise.all([...want].map((y) => shards.get(y)));
  }

  async function loadTracks(list: DeploymentSummary[]): Promise<void> {
    const run = ++trackRun;
    const want = list.slice(0, TRACK_CAP);

    await loadShards(want);
    if (run !== trackRun) return;
    scheduleDraw();

    let next = 0;

    const worker = async (): Promise<void> => {
      for (;;) {
        if (run !== trackRun) return;
        const d = want[next++];
        if (!d) return;
        if (!tracks.has(d.id)) {
          const cached = cacheGet(d);
          if (cached) {
            tracks.set(d.id, cleanTrack(cached));
            if (run === trackRun) scheduleDraw();
            continue;
          }
          try {
            const url = tabledapUrl(DEFAULT_BASE, d.id, 'jsonlCSV',
              ['time', 'latitude', 'longitude'], { every: TRACK_EVERY });
            const res = await request(url);
            const { columns, rows } = await parseJsonlCsvStream(res, {
              names: ['time', 'latitude', 'longitude'],
              timeColumns: new Set(['time']),
            });
            const lat = columns.get('latitude')!;
            const lon = columns.get('longitude')!;
            const secs = columns.get('time')!;
            const path: Array<[number, number]> = [];
            /* Kept alongside so the speed rule has something to work with:
               a live fetch knows when each fix was taken, and the archive —
               which does not carry the seconds — falls back to distance. */
            const when: number[] = [];
            for (let i = 0; i < rows; i++) {
              if (Number.isFinite(lat[i]) && Number.isFinite(lon[i])) {
                path.push([lat[i], lon[i]]);
                when.push(secs[i]);
              }
            }
            /* Cached raw. The rule that splits it is a drawing decision and
               belongs where it can be changed without invalidating a cache. */
            cachePut(d, path);
            tracks.set(d.id, cleanTrack(path, when));
          } catch {
            /* A deployment whose positions cannot be read keeps its marker
               and no track. Not worth a message: the dot is still there and
               still opens the page. */
            tracks.set(d.id, []);
          }
        }
        /* Both: a deployment's dot steps aside once its path is drawn, and
           that only happens if the markers are repainted too. */
        if (run === trackRun) scheduleDraw();
      }
    };

    await Promise.all(Array.from({ length: 6 }, worker));
    if (run === trackRun) { scheduleDraw(); flushCache(); }
  }

  /** The clock every track is coloured against: the span of what is shown. */
  function trackSpan(): { lo: number; hi: number } {
    let lo = Infinity;
    let hi = -Infinity;
    for (const d of shown.slice(0, TRACK_CAP)) {
      if (Number.isFinite(d.start)) lo = Math.min(lo, d.start);
      if (Number.isFinite(d.end)) hi = Math.max(hi, d.end);
    }
    return Number.isFinite(lo) && hi > lo ? { lo, hi } : { lo: 0, hi: 1 };
  }

  /**
   * Redraws coalesced to one a frame.
   *
   * Tracks arrive one at a time from the DAC and a shard at a time from here,
   * and each arrival used to repaint every track on the map. At sixty that
   * was invisible; at two thousand it is the same work two thousand times,
   * and the tab stops answering the pointer while it happens.
   *
   * **Not `requestAnimationFrame`.** A background tab never runs one, so a
   * reader who opens the page in a second tab and comes back finds every
   * track loaded and none of them drawn — the same trap that turned off
   * Leaflet's tile fade, one layer up. A timer runs either way; a background
   * tab merely throttles it, which is the correct behaviour for a repaint
   * nobody is looking at.
   */
  let drawPending: ReturnType<typeof setTimeout> | 0 = 0;
  function scheduleDraw(): void {
    if (drawPending) return;
    drawPending = setTimeout(() => {
      drawPending = 0;
      drawTracks();
      drawMarkers();
      say();
    }, 16);
  }

  /**
   * How finely each track is cut, given how many are on screen.
   *
   * A track is drawn as a run of short polylines so its colour can change
   * along it — that gradient is what makes the direction of travel readable.
   * The cost is one SVG path per stretch, so forty stretches times two
   * thousand missions is eighty thousand paths, and the map stops being a
   * map.
   *
   * The budget is on the total, and it works out because **the thing being
   * given up disappears at exactly the same rate**. The colour runs over one
   * absolute clock shared by every track on screen, so with the whole archive
   * up that clock spans two decades and each mission is essentially one
   * colour already — a gradient along it would be indistinguishable from a
   * flat line. Filtered down to a season, the span is weeks, the gradient
   * carries real information, and there is budget for all forty.
   */
  const SEGMENT_BUDGET = 2400;
  const segmentsPer = (n: number): number =>
    Math.max(1, Math.min(40, Math.round(SEGMENT_BUDGET / Math.max(1, n))));

  function drawTracks(): void {
    trackLayer.clearLayers();
    const { lo, hi } = trackSpan();
    const list = shown.slice(0, TRACK_CAP);
    let runCount = 0;
    for (const d of list) runCount += tracks.get(d.id)?.length ?? 0;
    const cuts = segmentsPer(runCount);

    for (const d of list) {
      const runs = tracks.get(d.id);
      if (!runs || !runs.length) continue;

      /* A mission's fixes come as one or more runs — see `cleanTrack`. Where
         it was carried rather than swimming, the pen lifts: the position
         either side is real and the line between them is not. */
      const total = runs.reduce((n, r) => n + r.length, 0);
      const span = d.end > d.start ? d.end - d.start : 1;
      let before = 0;

      for (const path of runs) {
        /* One polyline per stretch so the colour can change along it, which
           is what makes the direction of travel readable. They are drawn
           only — the whole path shares one invisible hit line below.
           The stride divides the *gaps*, not the points, and the loop runs
           while a gap is left: at one stretch that has to come out as the
           whole path rather than as nothing, which dividing the points does. */
        const step = Math.max(1, Math.ceil((path.length - 1) / cuts));
        for (let i = 0; i + 1 < path.length; i += step) {
          const seg = path.slice(i, Math.min(i + step + 1, path.length));
          /* Where this stretch falls on the shared clock: the mission's own
             position in it, plus how far along the mission the stretch is.
             Counted over every run, so a break does not restart the clock. */
          const at = d.start + ((before + i + step / 2) / Math.max(1, total - 1)) * span;
          const t = Math.min(1, Math.max(0, (at - lo) / (hi - lo)));
          L.polyline(seg, {
            color: sample(TRACK_COLORMAP, t),
            weight: isActive(d) ? 2.5 : 1.8,
            opacity: isActive(d) ? 0.95 : 0.65,
            interactive: false,
          }).addTo(trackLayer);
        }
        before += path.length;
      }

      /**
       * **One transparent, fat line per track, carrying the click.**
       *
       * A 2.5 px stroke is very hard to hit with a pointer, and a diagonal
       * one is worse: its bounding box is mostly not the line. Widening the
       * *target* without widening the mark is the standard answer, and doing
       * it once per track rather than per segment keeps the interactive
       * layer count at one per mission instead of forty.
       *
       * Leaflet takes an array of arrays as a multi-polyline, so a mission
       * broken into runs still costs exactly one interactive layer — and the
       * target follows the runs rather than bridging them, so the reader
       * cannot click a line that is not drawn.
       */
      const hit = L.polyline(runs, {
        color: '#000',
        opacity: 0,
        weight: 14,
        className: 'track-hit',
        bubblingMouseEvents: false,
      });
      hit.bindTooltip(`${d.title || d.id} — ${date(d.start)} → ${date(d.end)}`, { sticky: true });
      hit.on('click', () => { location.href = link(d.id); });
      hit.addTo(trackLayer);
    }
  }

  function drawMarkers(): void {
    markers.clearLayers();
    const subset = shown.slice(0, TRACK_CAP);

    /**
     * **A dot for a finished mission gets out of the way of the tracks.**
     *
     * Back when the archive had no paths, the dot was all an archived
     * deployment had, and 500 of them at full size was the map. With every
     * mission's track drawn it is the other way round: at that size, 2,481
     * dark discs bury exactly the thing they used to stand in for — the US
     * east coast and the Gulf went solid and the transits underneath them
     * disappeared.
     *
     * It shrinks rather than going away, because it is still the only thing
     * saying which end of a path is the recent one. A glider still reporting
     * keeps full size whatever else is on screen: "where is it now" is the
     * question the map is opened with, and it has an answer for exactly
     * those.
     */
    const dense = subset.filter((d) => !isActive(d)).length > 150;

    for (const d of subset) {
      /**
       * **The dot marks where the glider is now**, or was when it last
       * reported — which is the question a reader opens this map with, and
       * the one a bare path does not answer: a track has two ends and
       * nothing on it says which is the recent one.
       *
       * At the end of the path once there is one, and at the centre of the
       * deployment's bounding box until then, so the dot is on screen from
       * the first paint rather than appearing seconds later.
       */
      /* The end of the last run the glider actually swam. Taken from the raw
         record it could be the bad fix itself, which would put the dot — the
         one mark on the map claiming to say where the vehicle is — in an
         ocean it was never in. */
      const runs = tracks.get(d.id);
      const main = runs?.length ? mainRuns(runs) : [];
      const last = main.length ? main[main.length - 1] : null;
      const end = last ? last[last.length - 1] : null;
      const lat = end ? end[0] : (d.south + d.north) / 2;
      const lon = end ? end[1] : (d.west + d.east) / 2;
      if (!Number.isFinite(lat) || !Number.isFinite(lon)) continue;
      const live = isActive(d);
      /* The ring has to be wide enough to be a ring. At weight 1 it is a
         hairline the tile's own texture eats; 2.5 and 2 hold up against the
         bathymetry contours the basemap draws at about the same width — and
         the radii grow to leave a body inside the ring. Whole numbers
         because Leaflet rounds the radius into the path anyway. */
      const marker = L.circleMarker([lat, lon], {
        radius: live ? 7 : (dense ? 3 : 5),
        weight: live ? 2.5 : (dense ? 1 : 2),
        className: live ? 'marker-live' : 'marker-past',
      });
      /* Built on open rather than up front. Two and a half thousand popups
         is two and a half thousand detached subtrees the reader will look at
         one of; Leaflet takes a function and calls it when one is asked for.

         DOM, not an HTML string: the title and institution are written by
         whoever published the dataset, and this page's CSP has no
         `unsafe-inline` to fall back on if one of them ever contains
         markup. */
      marker.bindPopup(() => {
        const box = document.createElement('div');
        const a = document.createElement('a');
        a.href = link(d.id);
        a.textContent = d.title || d.id;
        box.append(a);
        const meta = document.createElement('span');
        meta.className = 'id';
        meta.textContent =
          `${d.institution || 'unknown institution'} · ${date(d.start)} → ${date(d.end)}`;
        box.append(document.createElement('br'), meta);
        return box;
      });
      marker.addTo(markers);
    }
  }

  /** Set when the catalog came from the snapshot rather than the server.
      Kept out of `say()`'s computed line because `say()` runs on every
      render and would otherwise erase it on the first keystroke. */
  let notice = '';

  function say(): void {
    const total = all.length.toLocaleString();
    const live = all.filter(isActive).length;
    const showing = shown.length.toLocaleString();
    const counts =
      `${showing} of ${total} deployments · ${live} reporting in the last ${ACTIVE_DAYS} days`;
    /* Said out loud: a map showing sixty tracks out of four hundred matches
       should not look like a map of all four hundred. */
    const capped = shown.length > TRACK_CAP
      ? ` · tracks drawn for the first ${TRACK_CAP}`
      : '';
    /* A colour that means something the reader cannot see the key to means
       nothing. The span is the key. */
    const { lo, hi } = trackSpan();
    const scale = shown.length && hi > lo
      ? ` · tracks coloured ${date(lo)} → ${date(hi)}`
      : '';
    status.textContent = notice
      ? `${counts} — ${notice}`
      : `${counts}${capped}${scale}`;
  }

  function fillYears(): void {
    const years = new Set<number>();
    for (const d of all) {
      const y = new Date(d.start * 1000).getUTCFullYear();
      if (Number.isFinite(y)) years.add(y);
    }
    for (const y of [...years].sort((a, b) => b - a)) {
      const opt = document.createElement('option');
      opt.value = String(y);
      opt.textContent = String(y);
      yearSel.append(opt);
    }
  }

  for (const el of [search, yearSel]) {
    el.addEventListener('input', () => { limit = PAGE; render(); });
  }
  activeBtn.addEventListener('click', () => {
    const on = activeBtn.getAttribute('aria-pressed') === 'true';
    activeBtn.setAttribute('aria-pressed', String(!on));
    limit = PAGE;
    render();
  });
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort as typeof sortKey;
      if (key === sortKey) sortDir = -sortDir as 1 | -1;
      else { sortKey = key; sortDir = key === 'title' || key === 'institution' ? 1 : -1; }
      render();
    });
  }

  /**
   * The catalog: live, with the committed snapshot as the fallback.
   *
   * Live first because it is 572 KB in a quarter of a second — measured —
   * and always current, where the snapshot is as old as the last deploy.
   * The fallback is what keeps the page useful when the DAC is down, which
   * is the one time a reader most wants to know what was out there.
   */
  async function load(): Promise<void> {
    try {
      setCatalog(await listDatasets());
    } catch {
      try {
        const res = await fetch(withBase('/data/deployments.json'));
        const doc = await res.json() as { fetched: number; deployments: DeploymentSummary[] };
        setCatalog(doc.deployments);
        notice = `the DAC did not answer, so this is a snapshot from ${date(doc.fetched)}`;
        fillYears();
        render();
        return;
      } catch {
        status.textContent = 'The catalog could not be loaded, and no snapshot was available.';
        return;
      }
    }
    fillYears();
    render();
  }

  void load();
</script>
