---
import PlotFigure from './PlotFigure.astro';
---

<div class="view" data-view>
  <header class="head">
    <p class="eyebrow" data-eyebrow>IOOS Glider DAC</p>
    <h1 data-title>Loading…</h1>
    <p class="meta mono" data-meta></p>
    <div class="progress" data-progress hidden>
      <div class="bar"><span data-bar></span></div>
      <p class="mono muted" data-progress-text></p>
      <button class="btn" type="button" data-stop>Stop</button>
    </div>
    <p class="problem" data-problem hidden></p>

    <div class="window" data-window>
      <label>
        <span class="eyebrow">from</span>
        <input class="field" type="datetime-local" data-from />
      </label>
      <label>
        <span class="eyebrow">to</span>
        <input class="field" type="datetime-local" data-to />
      </label>
      <button class="btn" type="button" data-apply>Load this window</button>
      <button class="btn" type="button" data-whole disabled>Whole deployment</button>
      <span class="mono muted hint" data-window-hint
        >or drag across any section below</span
      >
    </div>
  </header>

  <section class="pair">
    <figure class="map-figure">
      <!--
        Two rows, and that is a layout decision rather than a whim: the map
        fills whatever height this caption leaves it, so anything that can
        reflow here resizes the map under the reader. Both rows hold fixed
        content — capped selects, a reserved range slot — so the height is
        the same whatever is chosen.
      -->
      <figcaption class="topline">
        <h3 class="figure-title">Track</h3>
      </figcaption>
      <div class="map" data-map role="application" aria-label="Glider track"></div>
      <!--
        Under the map, where a legend belongs: the two menus decide what the
        colours mean and the ramp and range say what they are, so they read
        as one strip rather than as chrome above the picture.
      -->
      <div class="track-controls">
        <div class="row">
          <label class="eyebrow" for="track-colour">colour by</label>
          <select class="field" id="track-colour" data-track-colour></select>
        </div>
        <div class="row">
          <label class="eyebrow" for="track-map">scale</label>
          <select class="field" id="track-map" data-track-map></select>
          <span class="ramp" data-track-ramp aria-hidden="true"></span>
        </div>
        <div class="row">
          <label class="eyebrow" for="track-lo">range</label>
          <input class="field" type="number" step="any" id="track-lo" data-track-lo
            aria-label="Colour range, lowest value" />
          <input class="field" type="number" step="any" data-track-hi
            aria-label="Colour range, highest value" />
          <button class="btn" type="button" data-track-auto>Auto</button>
          <span class="mono muted" data-track-note></span>
        </div>
      </div>
    </figure>
    <div class="ts">
      <PlotFigure id="ts" title="T–S diagram" hint="Waiting for data…" />
    </div>
  </section>

  <section class="sections">
    <h2>Sections</h2>
    <p class="muted lede">
      Every variable this deployment carries, against time and depth. Computed
      properties are marked; the rest are as the DAC published them.
    </p>
    <div class="chips" data-chips role="group" aria-label="Variables to plot"></div>
    <div data-figures></div>
  </section>

  <!--
    Profiles: the same rows as the sections, drawn against depth instead of
    time. It had its own window controls and its own fetch, which was a
    second way to ask the same question and a second answer to keep in step
    with the first. The window at the top of the page now governs every
    figure, so these read whatever is loaded.

    Two of them, side by side, because a profile is read against another
    profile: temperature beside salinity is how you tell a thermocline from
    a halocline, and how you see which of the two a density step came from.
    Either axis is the reader's to change.
  -->
  <section class="profiles">
    <h2>Profiles</h2>
    <p class="muted lede">
      Every profile in the loaded window, against depth. Two panels so a pair
      can be compared; both take any variable.
    </p>
    <div class="pair">
      <PlotFigure id="profile" title="Temperature" hint="Waiting for data…" />
      <PlotFigure id="profile2" title="Salinity" hint="Waiting for data…" />
    </div>
  </section>

  <details class="aside">
    <summary>About this deployment</summary>
    <div class="prose">
      <p data-summary></p>
      <p class="mono" data-resolution></p>
      <p>
        <label class="inline">
          <input type="checkbox" data-qc checked />
          Hide values their QARTOD flag marks <em>fail</em> or <em>missing</em>
        </label>
      </p>
      <p data-links></p>
    </div>
  </details>
</div>

<style>
  .head {
    margin-block: var(--space-xl) var(--space-lg);
  }

  h1 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2xs) var(--space-xs);
    overflow-wrap: anywhere;
  }

  .meta {
    color: var(--text-muted);
  }

  .progress {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
    flex-wrap: wrap;
  }

  .bar {
    flex: 1 1 12rem;
    max-width: 22rem;
    height: 4px;
    background: var(--bg-subtle);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s ease;
  }

  .problem {
    margin-block-start: var(--space-sm);
    color: var(--text);
    border-inline-start: 3px solid var(--accent);
    padding-inline-start: var(--space-sm);
  }

  .window {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-xs) var(--space-sm);
    margin-block-start: var(--space-md);
  }

  .window label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hint {
    align-self: center;
  }

  .pair {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: 1fr;
    margin-block-end: var(--space-xl);
  }

  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }

    .map-figure {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .map {
      flex: 1 1 auto;
    }
  }

  .map-figure {
    margin: 0;
  }

  /**
   * The map fills the T–S column's full height, rather than standing at a
   * height of its own.
   *
   * It was a flat 30rem beside a figure whose height is the plot plus its
   * axis labels, its caption and its controls — so the two columns ended at
   * different places and the row had a ragged foot. Stretching is also the
   * only version that stays right when the reader changes the plot's height,
   * which is a control the figure offers.
   *
   * Only above the breakpoint: below it the grid is a single column, each
   * row sizes itself, and `flex: 1` against no definite height would collapse
   * the map to nothing — hence the floor, which is what the stacked layout
   * actually uses.
   */
  .map {
    min-height: 22rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  /**
   * **The map's caption matches the figure's head, margins included.**
   *
   * `global.css` gives `.topline` a top margin of `--space-md`, written for
   * a caption above a full-width map. Beside a `PlotFigure`, whose head has
   * none, that put "Track" exactly 20 px below "T–S diagram" — two titles
   * that are peers, sitting on different lines. Overriding only
   * `margin-block-end`, as this rule first did, left the top margin in place
   * and the misalignment with it.
   *
   * The end margin matches the head's too, so the map's top edge lands level
   * with the plot's.
   */
  .topline {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block: 0 var(--space-xs);
    flex-wrap: wrap;
  }

  /* Three rows, each one line: what the colours mean, what scale they use,
     and what range they span. Fixed content per row, so the strip's height
     does not change with the choices — the map fills what this leaves it,
     and a reflow here would resize the map under the reader. */
  .track-controls {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-block-start: var(--space-xs);
    min-width: 0;
  }

  /* **A fixed row height, because the range boxes change type.** On a time
     axis they become `datetime-local`, which the browser renders about 2 px
     taller than a `number` — and since the map fills what this strip leaves
     it, switching the colour variable resized the map by that much. Small,
     and the same class of twitch as the readout that started all this. */
  .track-controls .row {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    min-height: 2.15rem;
  }

  /* One column for the three labels, so the controls line up down the strip
     rather than starting at three different places. */
  .track-controls .row > .eyebrow:first-child {
    flex: 0 0 auto;
    min-width: 7ch;
    white-space: nowrap;
  }

  /**
   * **A select is as wide as its widest option**, and the widest here is
   * "Potential density anomaly σ₀ (kg/m³)". Left to size itself it pushed
   * the caption onto three lines — an 85 px strip above a map that had to
   * give up the same 65 px, because the map fills what the row leaves it.
   * Capped, and the browser truncates the option text itself.
   */
  .track-controls select {
    min-width: 0;
  }

  [data-track-colour] {
    flex: 1 1 auto;
    max-width: 15rem;
  }

  [data-track-map] {
    flex: 0 1 auto;
    max-width: 10rem;
  }

  [data-track-lo],
  [data-track-hi] {
    flex: 0 1 7rem;
    min-width: 0;
  }

  .ramp {
    display: flex;
    flex: 0 0 auto;
    height: 1.4rem;
    width: 4rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* The range changes length as the variable changes, so it is reserved:
     otherwise picking a variable reflows the caption and takes the height
     out of the map below it. */
  [data-track-note] {
    min-width: 15ch;
    text-align: end;
    white-space: nowrap;
  }

  h2 {
    margin-block-end: var(--space-2xs);
  }

  .lede {
    max-width: var(--prose-width);
    margin-block-end: var(--space-sm);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-block-end: var(--space-lg);
  }

  .profiles {
    margin-block-start: var(--space-xl);
  }

  /* The profile pair shares `.pair`'s grid, but not the map row's stretch:
     two figures of the same height have nothing to stretch to, and
     `align-items: start` keeps their titles on one line. */
  .profiles .pair {
    align-items: start;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-xs) var(--space-sm);
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .inline {
    flex-direction: row;
    align-items: center;
    gap: var(--space-xs);
  }
</style>

<style is:global>
  /* Chips are built at runtime, so these cannot be scoped. */
  [data-chips] .chip {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    background: none;
    color: var(--text-muted);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: var(--space-2xs) var(--space-sm);
    cursor: pointer;
  }

  [data-chips] .chip:hover {
    color: var(--text);
    border-color: var(--text-muted);
  }

  [data-chips] .chip[aria-pressed='true'] {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  [data-track-ramp] span {
    flex: 1;
  }

  /* A small dot marking a property computed here rather than published. */
  [data-chips] .chip .computed {
    display: inline-block;
    width: 0.45em;
    height: 0.45em;
    margin-inline-end: 0.4em;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 0.1em;
    opacity: 0.7;
  }

  /* A stretch whose chosen variable has no value there. The path is still
     where the glider went. */
  .track-unknown {
    stroke: var(--text-muted);
    opacity: 0.35;
  }

  .track-start {
    stroke: var(--text);
    fill: var(--bg);
    fill-opacity: 1;
  }

  .track-end {
    stroke: var(--accent);
    fill: var(--accent);
    fill-opacity: 0.9;
  }
</style>
